{
  "name": "dsh-hybrid-workspace-v2",
  "version": "2.6.3",
  "description": "单聊天框 + 多工作区上下文路由 v2.6.3：入口两跳确认、工作区绑定的收件箱子会话、隐私可控的混合路由、P3 独立壳聊天页与工作区治理、每区策略、导出导入（含全局档案与来源链）、trace 解释、迁移逐条勾选、结论演变、连续问句拆段",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuoyuan333/dsh-hybrid-workspace-v2.git"
  },
  "homepage": "https://github.com/zuoyuan333/dsh-hybrid-workspace-v2#readme",
  "bugs": {
    "url": "https://github.com/zuoyuan333/dsh-hybrid-workspace-v2/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "scripts": {
    "test": "node test/all.mjs",
    "build-shell": "scripts/build-shell-macos.sh"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "scripts",
    "shell"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
